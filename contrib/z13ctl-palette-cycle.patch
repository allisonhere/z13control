+// SendPalette starts a daemon-managed smooth cycle through 2–8 colors.
+// The animation continues after the client disconnects. device follows the
+// same targeting rules as SendApply.
+func SendPalette(device string, palette []string, speed string, brightness int) (bool, error) {
+	handled, resp, err := sendCommand(request{
+		Cmd:        "palette",
+		Palette:    palette,
+		Speed:      speed,
+		Brightness: brightness,
+		Device:     device,
+	})
+	if !handled || err != nil {
+		return handled, err
+	}
+	if !resp.OK {
+		return true, fmt.Errorf("%s", resp.Error)
+	}
+	return true, nil
+}
