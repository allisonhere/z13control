+package daemon
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParsePalette(t *testing.T) {
+	t.Parallel()
+	got, err := parsePalette([]string{"ff0000", "00FF00", "0000ff"})
+	if err != nil {
+		t.Fatalf("parsePalette: %v", err)
+	}
+	if got[0] != (paletteRGB{r: 255}) || got[1] != (paletteRGB{g: 255}) || got[2] != (paletteRGB{b: 255}) {
+		t.Fatalf("unexpected colors: %#v", got)
+	}
+
+	for _, colors := range [][]string{
+		{"FF0000"},
+		{"FF0000", "not-a-color"},
+		{"000000", "111111", "222222", "333333", "444444", "555555", "666666", "777777", "888888"},
+	} {
+		if _, err := parsePalette(colors); err == nil {
+			t.Errorf("parsePalette(%v) unexpectedly succeeded", colors)
+		}
+	}
+}
+
+func TestPaletteColorAtInterpolatesAndWraps(t *testing.T) {
+	t.Parallel()
+	colors := []paletteRGB{{r: 255}, {g: 255}, {b: 255}}
+	duration := 12 * time.Second
+
+	tests := []struct {
+		elapsed time.Duration
+		want    paletteRGB
+	}{
+		{0, paletteRGB{r: 255}},
+		{2 * time.Second, paletteRGB{r: 128, g: 128}},
+		{4 * time.Second, paletteRGB{g: 255}},
+		{8 * time.Second, paletteRGB{b: 255}},
+		{10 * time.Second, paletteRGB{r: 128, b: 128}},
+		{12 * time.Second, paletteRGB{r: 255}},
+	}
+	for _, tt := range tests {
+		if got := paletteColorAt(colors, tt.elapsed, duration); got != tt.want {
+			t.Errorf("at %v: got %#v, want %#v", tt.elapsed, got, tt.want)
+		}
+	}
+}
+
+func TestPaletteDurations(t *testing.T) {
+	t.Parallel()
+	wants := map[string]time.Duration{
+		"slow": 24 * time.Second, "normal": 12 * time.Second, "fast": 6 * time.Second,
+	}
+	for speed, want := range wants {
+		got, err := paletteDuration(speed)
+		if err != nil || got != want {
+			t.Errorf("%s: got %v, %v; want %v", speed, got, err, want)
+		}
+	}
+	if _, err := paletteDuration("turbo"); err == nil {
+		t.Error("unknown speed unexpectedly accepted")
+	}
+}

