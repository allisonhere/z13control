new file mode 100644
index 0000000..9a36c9f
--- /dev/null
+++ b/internal/daemon/palette.go
@@ -0,0 +1,167 @@
+package daemon
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"math"
+	"strings"
+	"time"
+
+	"github.com/dahui/z13ctl/api"
+	"github.com/dahui/z13ctl/internal/aura"
+	"github.com/dahui/z13ctl/internal/cli"
+	"github.com/dahui/z13ctl/internal/hid"
+)
+
+const (
+	paletteMinColors = 2
+	paletteMaxColors = 8
+	// Direct mode uses one feature report per zone and is designed for streaming.
+	paletteFrameRate = 20
+)
+
+var paletteDurations = map[string]time.Duration{
+	"slow":   24 * time.Second,
+	"normal": 12 * time.Second,
+	"fast":   6 * time.Second,
+}
+
+type paletteRGB struct {
+	r, g, b uint8
+}
+
+func parsePalette(colors []string) ([]paletteRGB, error) {
+	if len(colors) < paletteMinColors || len(colors) > paletteMaxColors {
+		return nil, fmt.Errorf("palette requires %d–%d colors", paletteMinColors, paletteMaxColors)
+	}
+	out := make([]paletteRGB, len(colors))
+	for i, color := range colors {
+		r, g, b, err := cli.ParseColor(strings.ToUpper(color))
+		if err != nil {
+			return nil, fmt.Errorf("palette color %d: %w", i+1, err)
+		}
+		out[i] = paletteRGB{r: r, g: g, b: b}
+	}
+	return out, nil
+}
+
+func paletteDuration(speed string) (time.Duration, error) {
+	d, ok := paletteDurations[speed]
+	if !ok {
+		return 0, fmt.Errorf("unknown speed %q (valid: slow normal fast)", speed)
+	}
+	return d, nil
+}
+
+func paletteColorAt(colors []paletteRGB, elapsed, duration time.Duration) paletteRGB {
+	if len(colors) == 0 || duration <= 0 {
+		return paletteRGB{}
+	}
+	progress := float64(elapsed%duration) / float64(duration)
+	position := progress * float64(len(colors))
+	index := int(math.Floor(position)) % len(colors)
+	next := (index + 1) % len(colors)
+	fraction := position - math.Floor(position)
+	lerp := func(a, b uint8) uint8 {
+		return uint8(math.Round(float64(a) + (float64(b)-float64(a))*fraction))
+	}
+	return paletteRGB{
+		r: lerp(colors[index].r, colors[next].r),
+		g: lerp(colors[index].g, colors[next].g),
+		b: lerp(colors[index].b, colors[next].b),
+	}
+}
+
+func (d *Daemon) applyLightingZoneLocked(device string, target *hid.Device, ls api.LightingState, started time.Time) error {
+	if !ls.Enabled || ls.Mode != "palette" {
+		return applyZone(target, ls)
+	}
+	colors, err := parsePalette(ls.Palette)
+	if err != nil {
+		return err
+	}
+	duration, err := paletteDuration(ls.Speed)
+	if err != nil {
+		return err
+	}
+	first := colors[0]
+	if err := aura.Apply(target, aura.ModeStatic, first.r, first.g, first.b, 0, 0, 0, aura.SpeedNormal, uint8(ls.Brightness)); err != nil {
+		return err
+	}
+	if err := aura.InitDirect(target); err != nil {
+		return err
+	}
+	time.Sleep(50 * time.Millisecond)
+	if err := aura.UpdateDirect(target, first.r, first.g, first.b); err != nil {
+		return err
+	}
+	d.startPaletteLocked(device, colors, duration, started)
+	return nil
+}
+
+func (d *Daemon) startPaletteLocked(device string, colors []paletteRGB, duration time.Duration, started time.Time) {
+	targets := []string{device}
+	if device == "" {
+		targets = []string{"keyboard", "lightbar"}
+	}
+	for _, target := range targets {
+		d.stopPaletteLocked(target)
+		ctx, cancel := context.WithCancel(d.animationContext())
+		d.animations[target] = cancel
+		go d.runPalette(ctx, target, colors, duration, started)
+	}
+}
+
+func (d *Daemon) stopPaletteLocked(device string) {
+	if d.animations == nil {
+		d.animations = make(map[string]context.CancelFunc)
+	}
+	if device == "" {
+		for target, cancel := range d.animations {
+			cancel()
+			delete(d.animations, target)
+		}
+		return
+	}
+	if cancel, ok := d.animations[device]; ok {
+		cancel()
+		delete(d.animations, device)
+	}
+}
+
+func (d *Daemon) runPalette(ctx context.Context, device string, colors []paletteRGB, duration time.Duration, started time.Time) {
+	ticker := time.NewTicker(time.Second / paletteFrameRate)
+	defer ticker.Stop()
+	last := colors[0]
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case now := <-ticker.C:
+			color := paletteColorAt(colors, now.Sub(started), duration)
+			if color == last {
+				continue
+			}
+			d.mu.Lock()
+			if ctx.Err() != nil {
+				d.mu.Unlock()
+				return
+			}
+			if d.dev == nil {
+				d.mu.Unlock()
+				continue
+			}
+			target, err := d.dev.FilteredView(device)
+			if err == nil {
+				err = aura.UpdateDirect(target, color.r, color.g, color.b)
+			}
+			d.mu.Unlock()
+			if err != nil {
+				slog.Warn("palette frame failed", "device", device, "err", err)
+				continue
+			}
+			last = color
+		}
+	}
+}
