+// UpdateDirect streams one solid RGB frame without a SetMode commit. This is
+// the protocol path used by G-Helper for ambient and audio-reactive lighting.
+func UpdateDirect(d FeatureWriter, r, g, b uint8) error {
+	msg := make([]byte, 12)
+	msg[0] = auraID
+	msg[1] = 0xBC
+	msg[2] = 0x01
+	msg[3] = 0x01
+	msg[9] = r
+	msg[10] = g
+	msg[11] = b
+	if err := d.SetFeature(msg); err != nil {
+		return fmt.Errorf("update direct: %w", err)
+	}
+	return nil
+}
