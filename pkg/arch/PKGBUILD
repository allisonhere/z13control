pkgname=z13center-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='GTK4 control center for the ASUS ROG Flow Z13'
arch=('x86_64')
url='https://github.com/allisonhere/z13control'
license=('Apache-2.0')
depends=('gtk4' 'graphene' 'glib2' 'pango' 'cairo')
makedepends=('git' 'go' 'gobject-introspection-runtime' 'pkgconf')
optdepends=('z13ctl: hardware control daemon required for live control')
provides=('z13center')
conflicts=('z13center')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}"
  make VERSION="${pkgver}"
}

package() {
  cd "${srcdir}/${pkgname}"
  make DESTDIR="${pkgdir}" \
    PREFIX=/usr \
    UDEVDIR=/usr/lib/udev/rules.d \
    USERUNITDIR=/usr/lib/systemd/user \
    VERSION="${pkgver}" \
    install
}
